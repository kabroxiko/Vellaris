# Copy to `.env` in the repository root and adjust before `docker compose up -d`.
# `.env` is git-ignored; never commit real credentials.

# Root user of the MongoDB container. The connection string uses authSource=admin, so this is the admin database user.
MONGO_ROOT_USER=vellaris
MONGO_ROOT_PASSWORD=change-me

# Database that holds stored maps. DungeonMaster keeps its games in the database named by DM_MONGODB_URI; pointing
# both at `vellaris` shares one database (distinct collections), which is fine. Set a different name to separate them.
VELLARIS_MONGO_DB=vellaris

# Shared secret for /api/maps/*. Must match DM_VELLARIS_TOKEN on the game server; leave both empty to disable the gate.
VELLARIS_API_TOKEN=

# Stored maps expire this many seconds after their last read. 0 keeps them forever.
VELLARIS_MAP_TTL_SECONDS=0

# Host port the map service is published on, and the image tag to run.
VELLARIS_PORT=8080
VELLARIS_IMAGE_TAG=latest

# Existing Docker volume to reuse for Mongo. Find it with:
#   docker inspect mongodb --format '{{range .Mounts}}{{.Name}} {{end}}'
# Leave empty to start with a fresh volume named `vellaris_mongo_data` (an existing database is then NOT visible).
MONGO_DATA_VOLUME=

# Where the game server reaches Mongo. Keep 127.0.0.1 when it runs on this host; use 0.0.0.0 to expose it.
MONGO_BIND=127.0.0.1
MONGO_PORT=27017
